# Required since the Pyth Core upgrade on 26 August 2026. Every price endpoint
# on Hermes rejects an unauthenticated request, including the public instance.
# Register at Pyth Terminal to get one: https://terminal.pyth.network
PYTH_API_KEY=

# Optional. Defaults to the public instance.
HERMES_ENDPOINT=https://hermes.pyth.network

# Optional. How long a price may go without an update before it is reported
# STALE, while its market is open. Defaults to 30s.
STALE_AFTER=30s
