# Testnet only. Never put a mainnet secret key in this repository.

# The account that pays every base reserve and every fee. Fund it with
# friendbot, then keep an eye on num_sponsoring: each sponsored entry locks
# reserve on this account until it is revoked.
SPONSOR_SECRET=

# Optional. Leave empty and the scripts generate a fresh donor keypair each
# run, which is the interesting case: an account that does not exist yet.
DONOR_SECRET=

# Testnet USDC, issuer and code. The trustline the sponsor pays for.
USDC_CODE=USDC
USDC_ISSUER=

# Optional overrides.
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org
