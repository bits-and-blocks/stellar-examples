# Copy to .env.local and fill in. Every value here is safe to expose publicly.

# Privy app ID, from https://dashboard.privy.io -> your app -> Settings.
# Required: this is the one value the app cannot supply a default for.
#
# This is a public identifier, not a secret: it ships in the client bundle by
# design, and Privy scopes it with an allowed-origins list you configure in the
# dashboard. Add your localhost and Vercel domains there.
#
# Note what is NOT here: PRIVY_APP_SECRET. This app creates wallets and signs
# from the client (@privy-io/react-auth/extended-chains), so it has no server
# component and needs no server credential. See README, "The Privy glue".
NEXT_PUBLIC_PRIVY_APP_ID=

# Where contributions go. Defaults to a testnet G-address that already holds a
# USDC trustline, as the interim target. Replace with the pool contract's
# C-address when it is available — no code change is needed, because the only
# behavioural difference is that a contract recipient needs no trustline, and
# that is detected from the address prefix.
NEXT_PUBLIC_POOL_ADDRESS=

# The contributed asset. Defaults to Circle's testnet USDC, whose Stellar Asset
# Contract is already deployed.
#
# These exist for the fallback the brief provides: if Circle's faucet is flaky,
# point them at a demo asset from a throwaway issuer instead. The SAC is
# generated per-asset by the protocol, so everything downstream is identical —
# except that a fresh issuer's SAC has to be deployed first with
# createStellarAssetContract. scripts/verify-contribution.mts does exactly this.
NEXT_PUBLIC_ASSET_CODE=
NEXT_PUBLIC_ASSET_ISSUER=

# Stellar network settings are deliberately absent. The passphrase, Horizon URL,
# Soroban RPC URL and Friendbot URL are hardcoded to testnet in
# lib/stellar/network.ts so that no deployment can be pointed at mainnet.
