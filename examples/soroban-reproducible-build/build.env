# The pinned build toolchain. Single source of truth — build.sh, deploy.sh and
# the CI job all read this file, so there is exactly one place to bump.
#
# The tag is human-readable, the digest is what actually gets pulled. A tag is
# mutable and a digest is not: `stellar/stellar-cli:27.1.0` could be repushed
# tomorrow, sha256:a8a41b... could not. Because the image bundles the Rust
# toolchain (see the `rust1.97.1` in the tag), pinning the image transitively
# pins rustc, cargo, the wasm32 target and the whole system layer underneath.
# That is the entire reproducibility mechanism in this example.
STELLAR_CLI_IMAGE="stellar/stellar-cli:27.1.0-rust1.97.1-slim-trixie@sha256:a8a41b70c69a074f62f0356d88ef2d0d721a517acb144ea76a2917bb62f2a7ae"

# That digest is a multi-arch index; it resolves to a different image per
# platform. Forcing one platform means an arm64 laptop and an amd64 CI runner
# execute the identical image rather than two siblings.
BUILD_PLATFORM="linux/amd64"

CONTRACT_PACKAGE="reproducible-counter"
WASM_NAME="reproducible_counter.wasm"
